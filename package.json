{
  "name": "megumi",
  "version": "0.2.2",
  "description": "Local-first personal Agent for conversation-driven content discovery",
  "repository": {
    "type": "git",
    "url": "https://github.com/anwen0724/megumi.git"
  },
  "license": "MIT",
  "author": "Megumi contributors",
  "workspaces": [
    "packages/ai",
    "packages/agent",
    "packages/application"
  ],
  "main": ".vite/build/index.js",
  "scripts": {
    "start": "npm run rebuild:native:electron && electron-vite dev --watch",
    "build:desktop": "electron-vite build",
    "package": "npm run rebuild:native:electron && npm run build:desktop && electron-builder --config electron-builder.config.cjs --win --x64 --dir --publish never",
    "make": "npm run rebuild:native:electron && npm run build:desktop && electron-builder --config electron-builder.config.cjs --win --x64 --publish never && node scripts/release/record-artifacts.mjs --directory out/desktop",
    "publish": "node scripts/release/publish-draft.mjs",
    "release:verify:version": "node scripts/release/verify-release.mjs",
    "release:verify:artifacts": "node scripts/release/verify-nsis-artifacts.mjs",
    "release:serve": "node scripts/release/serve-update-fixture.mjs",
    "release:verify": "npm run release:verify:version && npm run typecheck:packages && npm run typecheck:product && npm test",
    "test": "npm run rebuild:native:node && vitest run",
    "typecheck:packages": "tsc --build tsconfig.packages.json",
    "typecheck:product": "tsc --project tsconfig.product.json --noEmit",
    "rebuild:native:electron": "electron-rebuild -f -w better-sqlite3",
    "rebuild:native:node": "npm rebuild better-sqlite3"
  },
  "devDependencies": {
    "@electron/fuses": "^1.8.0",
    "@electron/rebuild": "3.7.2",
    "@tailwindcss/postcss": "^4.2.4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/better-sqlite3": "^7.6.0",
    "@types/fs-extra": "^11.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/uuid": "^10.0.0",
    "drizzle-kit": "^0.31.10",
    "electron": "^33.0.0",
    "electron-builder": "26.0.12",
    "electron-vite": "5.0.0",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.14",
    "tailwindcss": "^4.2.0",
    "tsx": "^4.23.1",
    "typescript": "^5.7.0",
    "vite": "^5.0.12",
    "vitest": "^4.1.5"
  },
  "dependencies": {
    "@tweenjs/tween.js": "^25.0.0",
    "better-sqlite3": "^12.0.0",
    "drizzle-orm": "^0.45.2",
    "electron-updater": "6.6.2",
    "fs-extra": "^11.0.0",
    "i18next": "^26.3.6",
    "js-yaml": "4.3.2",
    "lucide-react": "^1.14.0",
    "mammoth": "^1.12.0",
    "pdf-parse": "^2.4.5",
    "pixi.js": "^8.19.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-i18next": "^17.0.9",
    "sherpa-onnx-node": "^1.13.4",
    "uuid": "^14.0.0",
    "zod": "^3.25.76",
    "zustand": "^5.0.0"
  }
}
