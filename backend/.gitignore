# Python virtual environment (created by `uv sync`)
.venv/

# Bytecode caches
__pycache__/
*.py[cod]

# Tool caches
.mypy_cache/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Test scratch directories, used when the system temp directory is not writable
.tmp-tests/
.tmp-verify/
.pytest-run/
pytest-cache-files-*/

# Local build output
dist/
build/
*.egg-info/
