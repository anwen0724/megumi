# Python virtual environment (uv writes its own .gitignore inside .venv as well)
.venv/

# Bytecode caches
__pycache__/
*.py[cod]

# Tool caches
.mypy_cache/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Test scratch directories
.tmp-tests/
pytest-cache-files-*/

# Build output
dist/
build/
*.egg-info/