e},"type":"function"},{"function":{"description":"Read the persisted local content for one Candidate in the current recommendation window.","name":"read_recommendation_candidate","parameters":{"properties":{"candidateId":{"type":"string"}},"required":["candidateId"],"type":"object"},"strict":false},"type":"function"},{"function":{"description":"Expose the next deterministic segment of the frozen Recommendation ranking.","name":"expand_recommendation_working_set","parameters":{"properties":{},"type":"object"},"strict":false},"type":"function"},{"function":{"description":"Publish the complete ordered Recommendation selection atomically.","name":"publish_recommendations","parameters":{"properties":{"items":{"items":{"properties":{"candidateId":{"type":"string"},"recommendationReason":{"type":"string"}},"required":["candidateId","recommendationReason"],"type":"object"},"maxItems":100,"minItems":1,"type":"array"}},"required":["items"],"type":"object"},"strict":false},"type":"function"}]}