ondition. Never call tools outside the Candidate Supply Tool Set.\n\n<candidate_supply_material>\n  <started_at>2026-01-15T08:00:00.000Z</started_at>\n  <execution>{\"startedAt\":\"2026-01-15T08:00:00.000Z\",\"trigger\":\"consumer_shortfall\"}</execution>\n  <pool>{\"counts\":{\"preparing\":0,\"pending_admission\":0,\"available\":1,\"reserved\":0,\"consumed\":0,\"rejected\":0,\"expired\":0},\"lowWatermark\":3,\"target\":6,\"hardLimit\":12,\"totalShortfall\":5,\"uncoveredInterestIds\":[],\"consumerShortfalls\":[]}</pool>\n  <interests>[{\"interestId\":\"evaluation:interest:typescript\",\"description\":\"TypeScript 工程实践\",\"status\":\"active\",\"interestRevision\":1,\"preference\":{\"scopeKey\":\"interest:evaluation:interest:typescript\",\"scope\":\"interest\",\"interestId\":\"evaluation:interest:typescript\",\"revision\":0,\"directions\":[]}}]</interests>\n  <exploration_preference>{\"scopeKey\":\"exploration\",\"scope\":\"exploration\",\"revision\":0,\"directions\":[]}</exploration_preference>\n  <negative_constraints>[]</negative_constraints>\n  <sources>[{\"sourceId\":\"open_web\",\"name\":\"Open Web\",\"access\":\"configured_provider\",\"supportedModes\":[\"relevance\"],\"supportsRead\":true,\"availability\":\"ready\"}]</sources>\n  <recent_query_outcomes>[{\"queryId\":\"evaluation:query:1\",\"query\":\"TypeScript 工程案例\",\"sourceId\":\"open_web\",\"mode\":\"relevance\",\"targetInterestIds\":[\"evaluation:interest:typescript\"],\"status\":\"succeeded\",\"normalizedResultCount\":1,\"newCandidateCount\":1,\"mergedCandidateCount\":0,\"alreadyRecommendedCount\":0,\"capacityRejectedCount\":0,\"completedAt\":\"2026-01-15T08:00:00.000Z\"},{\"queryId\":\"candidate-query:4ab0d96d-48e4-4f14-bb05-0b6ab5911d57\",\"query\":\"TypeScript 工程实践 最佳实践\",\"sourceId\":\"open_web\",\"mode\":\"relevance\",\"targetInterestIds\":[\"evaluation:interest:typescript\"],\"status\":\"succeeded\",\"normalizedResultCount\":0,\"newCandidateCount\":0,\"mergedCandidateCount\":0,\"alreadyRecommendedC