erest IDs. The ToolCall set is the Search Plan. Use Tool Results to revise the next calls; do not invent a persistent plan or search every Source for coverage.\n\nStop when the gap is gone, the remaining budget cannot repair it, no eligible Source is available, or the Tool Results establish the execution's zero-yield stopping condition. Never call tools outside the Candidate Supply Tool Set.\n\n<candidate_supply_material>\n  <started_at>2026-01-15T08:00:00.000Z</started_at>\n  <execution>{\"startedAt\":\"2026-01-15T08:00:00.000Z\",\"trigger\":\"evaluation\"}</execution>\n  <pool>{\"counts\":{\"preparing\":0,\"pending_admission\":3,\"available\":0,\"reserved\":0,\"consumed\":0,\"rejected\":0,\"expired\":0},\"lowWatermark\":3,\"target\":6,\"hardLimit\":12,\"totalShortfall\":6,\"uncoveredInterestIds\":[\"evaluation:interest:typescript\"],\"consumerShortfalls\":[]}</pool>\n  <interests>[{\"interestId\":\"evaluation:interest:typescript\",\"description\":\"TypeScript 类型系统与编译器演进\",\"status\":\"active\",\"interestRevision\":1,\"preference\":{\"scopeKey\":\"interest:evaluation:interest:typescript\",\"scope\":\"interest\",\"interestId\":\"evaluation:interest:typescript\",\"revision\":0,\"directions\":[]}}]</interests>\n  <exploration_preference>{\"scopeKey\":\"exploration\",\"scope\":\"exploration\",\"revision\":0,\"directions\":[]}</exploration_preference>\n  <negative_constraints>[]</negative_constraints>\n  <sources>[{\"sourceId\":\"open_web\",\"name\":\"Open Web\",\"access\":\"configured_provider\",\"supportedModes\":[\"relevance\"],\"supportsRead\":true,\"availability\":\"ready\"}]</sources>\n  <recent_query_outcomes>[{\"queryId\":\"candidate-query:5becd2a6-e642-46d9-9563-58f6e02cb3ca\",\"query\":\"TypeScript type system evolution new features\",\"sourceId\":\"open_web\",\"mode\":\"relevance\",\"targetInterestIds\":[\"evaluation:interest:typescript\"],\"status\":\"succeeded\",\"normalizedResultCount\":3,\"newCandidateCount\":3,\"mergedCandidateCount\":0,\"alreadyRecommen