"results"],"type":"object"},"parameters":{"additionalProperties":false,"properties":{"count":{"description":"Optional number of search results. Defaults to 5.","maximum":20,"minimum":1,"type":"integer"},"query":{"description":"Search query. Use a focused query containing the important names and constraints.","maxLength":400,"minLength":1,"type":"string"}},"required":["query"],"type":"object"},"promptSnippet":"Search the web and return result summaries."},{"annotations":{"idempotentHint":true,"openWorldHint":true,"readOnlyHint":true},"description":"Read an HTTP(S) page and return size-limited text content (up to 9,000 bytes).","executionMode":"parallel","name":"web_fetch","outputSchema":{"additionalProperties":false,"properties":{"content":{"type":"string"},"contentType":{"type":"string"},"finalUrl":{"type":"string"},"requestedUrl":{"type":"string"},"title":{"type":"string"},"truncated":{"type":"boolean"}},"required":["requestedUrl","finalUrl","contentType","content","truncated"],"type":"object"},"parameters":{"additionalProperties":false,"properties":{"url":{"description":"HTTP(S) URL to read.","minLength":1,"type":"string"}},"required":["url"],"type":"object"},"promptSnippet":"Read an HTTP(S) page and return text content."},{"description":"Update the current task plan with a complete ordered snapshot of its steps and statuses. Each update replaces the entire plan.","executionMode":"serial","name":"update_plan","parameters":{"additionalProperties":false,"properties":{"explanation":{"description":"Optional reason for this plan update.","type":"string"},"plan":{"items":{"additionalProperties":false,"properties":{"status":{"enum":["pending","in_progress","completed"],"type":"string"},"step":{"type":"string"}},"required":["step","status"],"type":"object"},"type":"array"}},"required":["plan"],"type":"object"},"promptSnippet":"Update the current task plan snapshot."}]}