stderrPreview","durationMs","truncated"],"type":"object"},"parameters":{"additionalProperties":false,"properties":{"command":{"description":"A command written for Windows PowerShell.","type":"string"},"cwd":{"description":"The working directory for the command. Relative paths are resolved from the current working directory.","type":"string"},"timeoutMs":{"description":"Optional timeout in milliseconds.","type":"integer"}},"required":["command"],"type":"object"},"promptGuidelines":["Command output is redacted; sensitive values are replaced before they reach you."],"promptSnippet":"Run a command and return redacted output previews."},{"annotations":{"idempotentHint":true,"openWorldHint":true,"readOnlyHint":true},"description":"Search the web and return structured result summaries and URLs. Returns up to 5 results by default (maximum 20).","executionMode":"parallel","name":"web_search","outputSchema":{"additionalProperties":false,"properties":{"query":{"type":"string"},"results":{"items":{"additionalProperties":false,"properties":{"snippet":{"type":"string"},"title":{"type":"string"},"url":{"type":"string"}},"required":["title","url","snippet"],"type":"object"},"type":"array"}},"required":["query","results"],"type":"object"},"parameters":{"additionalProperties":false,"properties":{"count":{"description":"Optional number of search results. Defaults to 5.","maximum":20,"minimum":1,"type":"integer"},"query":{"description":"Search query. Use a focused query containing the important names and constraints.","maxLength":400,"minLength":1,"type":"string"}},"required":["query"],"type":"object"},"promptSnippet":"Search the web and return result summaries."},{"annotations":{"idempotentHint":true,"openWorldHint":true,"readOnlyHint":true},"description":"Read an HTTP(S) page and return size-limited text content (up to 9,000 bytes).","executionMode":"parallel","name":"web_fetch","outputSchema":{"additionalProperties":false,"properties":{"content":{"type":"string"},"contentType":{"typ