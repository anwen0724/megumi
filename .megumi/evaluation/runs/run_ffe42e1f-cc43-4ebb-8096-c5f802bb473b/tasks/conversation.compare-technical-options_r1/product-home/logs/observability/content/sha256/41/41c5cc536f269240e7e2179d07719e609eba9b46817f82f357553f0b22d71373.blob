":"Copy a file or directory.","executionMode":"serial","name":"copy_path","parameters":{"additionalProperties":false,"properties":{"destination":{"description":"Destination path.","type":"string"},"overwrite":{"description":"Replace an existing destination.","type":"boolean"},"source":{"description":"Source path.","type":"string"}},"required":["source","destination"],"type":"object"},"promptSnippet":"Copy a file or directory."},{"annotations":{"destructiveHint":true,"idempotentHint":false,"openWorldHint":false},"description":"Move or rename a file or directory.","executionMode":"serial","name":"move_path","parameters":{"additionalProperties":false,"properties":{"destination":{"description":"Destination path.","type":"string"},"overwrite":{"description":"Replace an existing destination.","type":"boolean"},"source":{"description":"Source path.","type":"string"}},"required":["source","destination"],"type":"object"},"promptSnippet":"Move or rename a file or directory."},{"annotations":{"destructiveHint":true,"idempotentHint":false,"openWorldHint":false},"description":"Move a file or directory to a recoverable Workspace location. Deleted paths can be restored.","executionMode":"serial","name":"delete_path","parameters":{"additionalProperties":false,"properties":{"path":{"description":"Path to delete.","type":"string"},"recursive":{"description":"Allow a non-empty directory.","type":"boolean"}},"required":["path"],"type":"object"},"promptSnippet":"Move a file or directory to a recoverable location."},{"annotations":{"destructiveHint":true,"idempotentHint":false,"openWorldHint":false},"description":"Run a command and return output previews. Captures up to 20,000 bytes per stream (stdout and stderr).","executionMode":"serial","name":"run_command","outputSchema":{"properties":{"durationMs":{"type":"integer"},"exitCode":{"type":"integer"},"stderrPreview":{"type":"string"},"stdoutPreview":{"type":"string"},"truncated":{"type":"boolean"}},"required":["exitCode","stdoutPreview","stderrPreview","durationMs","truncated"],"type":"object"},"parameters":{"additionalProperties":false,"properties":{"command":{"description":"A command written for Windows PowerShell.","type":"string"},"cwd":{"description":"The working directory for the command. Relative paths are resolved from the current working directory.","type":"string"},"timeoutMs":{"description":"Optional timeout in milliseconds.","type":"integer"}},"required":["command"],"type":"object"},"promptGuidelines":["Command output is redacted; sensitive values are replaced before they reach you."],"promptSnippet":"Run a command and return redacted output previews."},{"annotations":{"idempotentHint":true,"openWorldHint":true,"readOnlyHint":true},"description":"Search the web and return structured result summaries and URLs. Returns up to 5 results by default (maximum 20).","executionMode":"parallel","name":"web_search","outputSchema":{"additionalProperties":false,"properties":{"query":{"type":"string"},"results":{"items":{"additionalProperties":false,"properties":{"snippet":{"type":"string"},"title":{"type":"string"},"url":{"type":"string"}},"required":["title","url","snippet"],"type":"object"},"type":"array"}},"required":["query","results"],"type":"object"},"parameters":{"additionalProperties":false,"properties":{"count":{"description":"Optional number of search results. Defaults to 5.","maximum":20,"minimum":1,"type":"integer"},"query":{"description":"Search query. Use a focused query containing the important names and constraints.","maxLength":400,"minLength":1,"type":"string"}},"required":["query"],"type":"object"},"promptSnippet":"Search the web and return result summaries."},{"annotations":{"idempotentHint":true,"openWorldHint":true,"readOnlyHint":true},"description":"Read an HTTP(S) page and return size-limited text content (up to 9,000 bytes).","executionMode":"parallel","name":"web_fetch","outputSchema":{"additionalProperties":false,"properties":{"content":{"type":"string"},"contentType":{"type":"string"},"finalUrl":{"type":"string"},"requestedUrl":{"type":"string"},"title":{"type":"string"},"truncated":{"type":"boolean"}},"required":["requestedUrl","finalUrl","contentType","content","truncated"],"type":"object"},"parameters":{"additionalProperties":false,"properties":{"url":{"description":"HTTP(S) URL to read.","minLength":1,"type":"string"}},"required":["url"],"type":"object"},"promptSnippet":"Read an HTTP(S) page and return text content."},{"description":"Update the current task plan with a complete ordered snapshot of its steps and statuses. Each update replaces the entire plan.","executionMode":"serial","name":"update_plan","parameters":{"additionalProperties":false,"properties":{"explanation":{"description":"Optional reason for this plan update.","type":"string"},"plan":{"items":{"additionalProperties":false,"properties":{"status":{"enum":["pending","in_progress","completed"],"type":"string"},"step":{"type":"string"}},"required":["step","status"],"type":"object"},"type":"array"}},"required":["plan"],"type":"object"},"promptSnippet":"Update the current task plan snapshot."}]}