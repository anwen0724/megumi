h":{"description":"The file to write. Relative paths are resolved from the current working directory.","type":"string"}},"required":["path","content"],"type":"object"},"promptSnippet":"Create or overwrite a UTF-8 text file."},{"annotations":{"destructiveHint":false,"idempotentHint":true,"openWorldHint":false},"description":"Create a directory.","executionMode":"serial","name":"create_directory","parameters":{"additionalProperties":false,"properties":{"path":{"description":"Directory path.","type":"string"},"recursive":{"description":"Create missing parent directories.","type":"boolean"}},"required":["path"],"type":"object"},"promptSnippet":"Create a directory."},{"annotations":{"destructiveHint":true,"idempotentHint":false,"openWorldHint":false},"description":"Copy a file or directory.","executionMode":"serial","name":"copy_path","parameters":{"additionalProperties":false,"properties":{"destination":{"description":"Destination path.","type":"string"},"overwrite":{"description":"Replace an existing destination.","type":"boolean"},"source":{"description":"Source path.","type":"string"}},"required":["source","destination"],"type":"object"},"promptSnippet":"Copy a file or directory."},{"annotations":{"destructiveHint":true,"idempotentHint":false,"openWorldHint":false},"description":"Move or rename a file or directory.","executionMode":"serial","name":"move_path","parameters":{"additionalProperties":false,"properties":{"destination":{"description":"Destination path.","type":"string"},"overwrite":{"description":"Replace an existing destination.","type":"boolean"},"source":{"description":"Source path.","type":"string"}},"required":["source","destination"],"type":"object"},"promptSnippet":"Move or rename a file or directory."},{"annotations":{"destructiveHint":true,"idempotentHint":false,"openWorldHint":false},"description":"Move a file or directory to a recoverable Workspace location. Deleted paths can be restored.","executionMode":"serial","name":"delete_path","parameters