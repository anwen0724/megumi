{
  "taskId": "conversation.plan-and-review-delivery",
  "revision": 2,
  "title": "规划并复审一次功能交付",
  "objective": "Agent 在同一 Session 中完成多材料分析、两个交付物创建以及后续自检修订。",
  "difficulty": "complex",
  "profiles": [
    "controlled"
  ],
  "tags": [
    "core",
    "multi-step",
    "file-work"
  ],
  "initialState": {
    "clock": "2026-01-15T08:00:00.000Z",
    "dailyTargetCount": 3,
    "workspaceFiles": [
      {
        "path": "project/feature-brief.md",
        "content": "# 功能目标\n\n为本地桌面应用新增可恢复的后台导入任务。用户可发起导入、查看进度、取消任务，并在重启后继续查看最终结果。\n"
      },
      {
        "path": "project/architecture.md",
        "content": "# 当前架构\n\nRenderer 只调用 IPC Contract；Main Host 负责进程能力；Product Owner 保存业务状态；Runtime Event 只传递瞬时进度，数据库保存最终任务事实。\n"
      },
      {
        "path": "project/constraints.md",
        "content": "# 约束\n\n不得让 Runtime Event 成为最终业务状态；取消必须幂等；失败不能阻止应用启动；本次不实现云同步；验证不包含打包。\n"
      },
      {
        "path": "project/review-notes.md",
        "content": "# 复审重点\n\n检查计划是否误把瞬时事件当持久状态；是否遗漏重启恢复和幂等取消；风险清单必须为每个高风险项给出验证方式。\n"
      }
    ],
    "sessions": [],
    "interests": [],
    "candidates": [],
    "recommendations": [],
    "preferences": [],
    "controlledSearch": [],
    "permissionDecision": "allow"
  },
  "input": {
    "type": "conversation",
    "steps": [
      {
        "userInput": "读取 project 下的 feature-brief.md、architecture.md 和 constraints.md，创建 delivery/implementation-plan.md 与 delivery/risk-checklist.md。计划要按依赖顺序拆分任务，说明模块职责和验证；风险清单要列出风险、影响、缓解和验证方式。",
        "permissionMode": "full_access"
      },
      {
        "userInput": "现在再读取 project/review-notes.md，复审你刚才创建的两个文件。发现遗漏或矛盾就直接修订原文件，并在最终回复中说明修订了哪些问题。不要新建第三份交付文档。",
        "permissionMode": "full_access"
      }
    ]
  },
  "timeoutMs": 240000,
  "metrics": [
    {
      "metricId": "business_completion_present",
      "title": "两轮业务执行均已完成",
      "evaluator": "rule",
      "rule": "business_completion_present",
      "required": true
    },
    {
      "metricId": "workspace_files_exist",
      "title": "目标文件已生成",
      "evaluator": "rule",
      "rule": "workspace_files_exist",
      "paths": [
        "delivery/implementation-plan.md",
        "delivery/risk-checklist.md"
      ],
      "required": true
    },
    {
      "metricId": "implementation_plan_structure",
      "title": "目标文件结构完整",
      "evaluator": "rule",
      "rule": "workspace_file_contains",
      "path": "delivery/implementation-plan.md",
      "contains": [
        "重启",
        "取消",
        "验证"
      ],
      "required": true
    },
    {
      "metricId": "risk_checklist_structure",
      "title": "目标文件结构完整",
      "evaluator": "rule",
      "rule": "workspace_file_contains",
      "path": "delivery/risk-checklist.md",
      "contains": [
        "风险",
        "缓解",
        "验证"
      ],
      "required": true
    },
    {
      "metricId": "task_completion",
      "title": "多步任务完成度",
      "evaluator": "model",
      "rubric": "判断两轮指令是否在同一任务上下文中完成，最终仅保留两份指定交付文档，并说明复审修订。",
      "minScore": 3,
      "required": true
    },
    {
      "metricId": "planning_quality",
      "title": "实施计划质量",
      "evaluator": "model",
      "rubric": "判断计划是否符合现有边界，按依赖顺序覆盖持久状态、瞬时进度、重启恢复、幂等取消和验证。",
      "minScore": 3,
      "required": true
    },
    {
      "metricId": "review_correction",
      "title": "复审修订质量",
      "evaluator": "model",
      "rubric": "判断第二轮是否真正利用 review-notes 发现并修正遗漏或矛盾，而不是只声称已检查。",
      "minScore": 3,
      "required": true
    },
    {
      "metricId": "cross_file_consistency",
      "title": "交付物一致性",
      "evaluator": "model",
      "rubric": "判断实施计划与风险清单对业务状态、Runtime Event、恢复、取消和验证的表述一致。",
      "minScore": 3,
      "required": true
    },
    {
      "metricId": "tool_use",
      "title": "完成了多步文件工作",
      "evaluator": "measurement",
      "measurement": "toolCalls",
      "operator": "min",
      "threshold": 5,
      "required": true
    }
  ]
}
