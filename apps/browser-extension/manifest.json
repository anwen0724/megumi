{
  "manifest_version": 3,
  "name": "Megumi Content Discovery",
  "version": "0.1.0",
  "description": "Runs user-authorized, read-only searches for Megumi.",
  "permissions": ["storage", "alarms", "tabs", "scripting"],
  "host_permissions": [
    "http://127.0.0.1/*",
    "https://*.xiaohongshu.com/*",
    "https://*.douyin.com/*",
    "https://*.zhihu.com/*"
  ],
  "background": { "service_worker": "src/background.js", "type": "module" },
  "options_page": "options.html",
  "action": { "default_title": "Megumi Content Discovery" }
}
